# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Microsoft sign-in (required to run the app at all — see README) ---
# From your Azure AD / Microsoft Entra ID app registration.
AZURE_AD_CLIENT_ID=f3e7ab12-d9f4-4b75-8bbb-88b5c3514c0c
					
AZURE_AD_TENANT_ID=7e6837f4-965d-4451-81e3-bd3e191feca7

# This app authenticates to Azure AD with a CERTIFICATE, not a client
# secret (some tenants block client secrets by policy — see README).
# Run `npm run generate-cert` and paste its two printed lines here.
AZURE_AD_CERT_PRIVATE_KEY_
AZURE_AD_CERT_

# PowerShell: $b=New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
# macOS/Linux: openssl rand -base64 32
NEXTAUTH_SECRET=
# The URL this app is reachable at. Must match the app registration's
# redirect URI: {NEXTAUTH_URL}/api/auth/callback/azure-ad
NEXTAUTH_URL=http://localhost:43127

# --- SharePoint inventory source (optional — omit any of these and the ---
# --- app falls back to the bundled local catalog only)                ---
# The SharePoint hostname, e.g. contoso.sharepoint.com
SHAREPOINT_SITE_HOSTNAME=
# Server-relative site path, e.g. /sites/ServiceOps
SHAREPOINT_SITE_PATH=
# Path to the workbook within the site's default document library,
# e.g. Shared Documents/Inventory.xlsx
SHAREPOINT_FILE_PATH=
# The Excel Table's name (Insert > Table, then name it in the Table
# Design tab) — not the worksheet name.
SHAREPOINT_TABLE_NAME=
